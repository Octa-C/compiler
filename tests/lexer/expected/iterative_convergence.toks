<FUNCTION,>
<IDENTIFIER, main>
<LPAREN,>
<RPAREN,>
<ARROW,>
<SCALAR, i32>
<LBRACE,>
<SCALAR, f32>
<IDENTIFIER, val>
<ASSIGNMENT, =>
<FLOAT, 100.0>
<SEMICOLON,>
<SCALAR, i32>
<IDENTIFIER, steps>
<ASSIGNMENT, =>
<INT, 0>
<SEMICOLON,>
<UNTIL,>
<LPAREN,>
<IDENTIFIER, val>
<LESS,>
<FLOAT, 1.0>
<OR,>
<IDENTIFIER, steps>
<IS,>
<INT, 20>
<RPAREN,>
<LBRACE,>
<IDENTIFIER, val>
<ASSIGNMENT, /=>
<FLOAT, 2.0>
<SEMICOLON,>
<IDENTIFIER, steps>
<ASSIGNMENT, +=>
<INT, 1>
<SEMICOLON,>
<RBRACE,>
<IDENTIFIER, printf>
<LPAREN,>
<STRING_LIT, "Converged in %d steps.">
<COMMA,>
<IDENTIFIER, steps>
<RPAREN,>
<SEMICOLON,>
<RETURN,>
<INT, 0>
<SEMICOLON,>
<RBRACE,>
<COMPILER_EOF,>
